<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Suite" parallel="false">

    <test name="TempMail Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="TempMail.CopyEmailTest"/>
            <class name="TempMail.VerifyLogo"/>
            <class name="TempMail.VerifyLanguageTest"/>
        </classes>
    </test>

    <test name="TempMail_Tests_firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="TempMail.CopyEmailTest"/>
            <class name="TempMail.VerifyLogo"/>
            <class name="TempMail.VerifyLanguageTest"/>
        </classes>
    </test>

    <test name="TempMail_Tests_edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="TempMail.CopyEmailTest"/>
            <class name="TempMail.VerifyLogo"/>
            <class name="TempMail.VerifyLanguageTest"/>
        </classes>
    </test>

</suite>
